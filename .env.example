# Keep your real keys in .env on your computer. Never share .env.
TRADYTICS_API_KEY=
# query follows the current Tradytics quickstart. Use bearer if your API setup specifies it.
TRADYTICS_AUTH_MODE=query

# Webull OpenAPI for stock and ETF prices and exact-expiry option snapshots.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_REGION=us
# Production market data. This app never submits orders.
WEBULL_ENDPOINT=api.webull.com
WEBULL_CATEGORY=AUTO
DEFAULT_TICKER=SPY

QUOTE_REFRESH_SECONDS=5
CANDLE_REFRESH_SECONDS=60
CHAIN_REFRESH_SECONDS=120
CHAIN_DISCOVERY_SECONDS=900
MAX_REQUESTS_PER_MINUTE=45
HISTORY_1M_BARS=1000
QUOTE_MAX_AGE_SECONDS=15
OPTION_MAX_AGE_SECONDS=120

# Bounded standard-contract universe. Width .02 means +/-2% from spot.
CHAIN_DTE_DAYS=7
CHAIN_STRIKE_WIDTH_PCT=0.02
CHAIN_MAX_PAGES=20
CHAIN_MAX_CONTRACTS=500
CHAIN_ROOT_SYMBOL=
RISK_FREE_RATE=0.04
DIVIDEND_YIELD=0.00

# Discord alerts (keep secret, do not commit)
DISCORD_WEBHOOK_URL=
# Auto uses Webull for covered stocks and ETFs when keys are present, and Tradytics for indices.
MONITOR_PRICE_SOURCE=Auto

# Optional shared watchlist and cloud research history. Set the token in your private environment.
# MONITOR_GITHUB_REPO=your-account/quant-desk-v2
# MONITOR_GITHUB_BRANCH=main
# Use a persistent SQLite file for one worker or the same PostgreSQL DSN in both services.
# MONITOR_JOURNAL_PATH=
# MONITOR_JOURNAL_DSN=
